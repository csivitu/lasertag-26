{
  "name": "lasertag-26",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.3.6",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "db:clean": "bun run apps/api/src/scripts/clean-db.ts",
    "db:seed": "bun run apps/api/src/seed.ts",
    "db:reset": "bun run db:clean && bun run db:seed",
    "prepare": "husky"
  },
  "lint-staged": {
    "apps/web/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": "bun run --cwd apps/web eslint --fix --no-warn-ignored",
    "{apps/api,apps/admin,packages}/**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}": "eslint --fix --no-warn-ignored"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.4.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "turbo": "^2.5.6",
    "typescript": "6",
    "typescript-eslint": "^8.69.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "nodemailer": "^10.0.6"
  }
}
