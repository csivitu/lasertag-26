{
  "expo": {
    "name": "LaserTag Staff",
    "slug": "lasertag-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "lasertagstaff",
    "backgroundColor": "#09090B",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#09090B"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LaserTag Staff app to access the camera for scanning participant QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
